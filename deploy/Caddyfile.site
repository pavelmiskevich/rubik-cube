# Блок сайта для системного веб-сервера общего VPS (/etc/caddy/Caddyfile).
#
# Добавляется отдельным блоком рядом с сайтами соседей; их блоки не трогаются.
# Порядок на сервере: резервная копия Caddyfile, правка, caddy validate, затем
# systemctl reload caddy — перезагрузка плавная, а не принятый конфиг не
# применяется, и старый продолжает работать.
#
# Сертификат выпускается автоматически, но только после того, как DNS-запись
# поддомена указывает на сервер.
rubik-cube.miskevich.ru {
	# tls <почта для уведомлений об истечении сертификата>
	header -Server
	reverse_proxy 127.0.0.1:3030
}
