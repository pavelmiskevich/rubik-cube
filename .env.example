# openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL="http://localhost:3030"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Docker: postgresql://postgres:<ВАШ_ПАРОЛЬ>@db:5432/rubik_db?schema=public
# Локально: postgresql://postgres:<ВАШ_ПАРОЛЬ>@127.0.0.1:5432/rubik_db?schema=public
