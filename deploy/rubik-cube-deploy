#!/bin/bash
# Выкладка rubik-cube на общем VPS.
#
# Ставится в /usr/local/bin/rubik-cube-deploy: владелец root, права 755.
# Пользователь rubik-deploy запускает его через sudo — правило в
# /etc/sudoers.d/rubik-cube-deploy разрешает ему только этот файл. Аргумент
# один: полный SHA коммита, образы которого CI уже опубликовал.
#
# Скрипт меняет только тег образа. Compose-файл и .env на сервере принадлежат
# root, и отсюда их не изменить.
#
# Порядок (#121) — чтобы сбой любого шага оставлял работать прежнюю версию:
#   1. Скачать оба образа. Нет образа — выкладки нет, стек не тронут.
#   2. Миграции — отдельным контейнером, пока работает старое приложение.
#      Упали — выход; image.env и приложение остаются как были. Миграции по
#      правилу проекта совместимы с предыдущей версией (deploy/README.md).
#   3. Записать новый тег в image.env и пересоздать только приложение.
#   4. Дождаться ответа 200. Нет ответа — вернуть прежний тег, поднять его и
#      выйти с ошибкой. Схему откат не трогает: миграции только вперёд.
#   5. Убрать образы этого проекта, кроме текущего и предыдущего.
#
# Переменные окружения нужны только тесту (deploy/test/deploy.test.sh): sudo
# их сбрасывает (env_reset), и на сервере работают значения по умолчанию.
set -euo pipefail

readonly DIR=${RUBIK_DIR:-/opt/rubik-cube}
# Тот же адрес, что в docker-compose.yml: скрипт по нему скачивает и чистит.
readonly IMAGE=${RUBIK_IMAGE:-ghcr.io/pavelmiskevich/rubik-cube}
# Попыток проверки ответа, по 2 секунды.
readonly HEALTH_TRIES=${DEPLOY_HEALTH_TRIES:-30}

sha="${1:-}"
if [[ ! "$sha" =~ ^[0-9a-f]{40}$ ]]; then
  echo "Использование: rubik-cube-deploy <полный SHA коммита>" >&2
  exit 2
fi

if [[ ! -d "$DIR" ]]; then
  echo "Нет каталога $DIR — стек не установлен, порядок в deploy/README.md" >&2
  exit 1
fi

# Две выкладки разом перепутали бы image.env и миграции. Блокировка — на
# собственном каталоге проекта, а не файлом в /run/lock: туда пишет любой
# пользователь общего сервера, и чужой заранее созданный и занятый файл молча
# остановил бы выкладки.
exec 9<"$DIR"
if ! flock -n 9; then
  echo "Выкладка уже идёт" >&2
  exit 1
fi

cd "$DIR"

# До скачивания образов: без .env стек не поднять, и лучше сказать это сразу,
# чем упасть на середине.
if [[ ! -f .env ]]; then
  echo "Нет $DIR/.env — секреты стека, порядок установки в deploy/README.md" >&2
  exit 1
fi

# image.env нет только до первой выкладки.
compose() {
  local env_files=(--env-file "$DIR/.env")
  if [[ -f "$DIR/image.env" ]]; then
    env_files+=(--env-file "$DIR/image.env")
  fi
  docker compose --project-directory "$DIR" -f "$DIR/docker-compose.yml" \
    "${env_files[@]}" "$@"
}

set_tag() {
  printf 'IMAGE_TAG=%s\n' "$1" > image.env.new
  mv image.env.new image.env
}

show_state() {
  compose ps -a >&2 || true
  compose logs --tail=200 app >&2 || true
}

# Ждёт ответа 200; последний код — в $code. Порт спрашивается у самого
# compose: так он совпадает с тем, что опубликовано, как бы ни была записана
# строка HOST_PORT в .env. Пока контейнер перезапускается, порта у него нет.
# /api/health отвечает 200, только если приложение достучалось до базы (#120).
# Релизы до него отвечают на этот адрес 404 — тогда проверяется /, иначе
# откат на такой релиз никогда бы не прошёл.
code=""
healthy() {
  local addr
  code=""
  for ((try = 0; try < HEALTH_TRIES; try++)); do
    addr=$(compose port app 3000 2>/dev/null || true)
    if [[ -n "$addr" ]]; then
      code=$(curl -s -m 5 -o /dev/null -w '%{http_code}' "http://$addr/api/health" || true)
      if [[ "$code" == "404" ]]; then
        code=$(curl -s -m 5 -o /dev/null -w '%{http_code}' "http://$addr/" || true)
      fi
      [[ "$code" == "200" ]] && return 0
    fi
    sleep 2
  done
  return 1
}

# 1. Скачать до того, как трогать работающий стек.
docker pull -q "$IMAGE:$sha"
docker pull -q "$IMAGE:migrate-$sha"

previous=""
if [[ -f image.env ]]; then
  previous=$(sed -n 's/^IMAGE_TAG=//p' image.env)
fi

# 2. Тег новой версии — только для этого запуска: image.env остаётся прежним,
# пока миграции не прошли. Переменная окружения сильнее --env-file.
echo "Миграции $sha"
if ! IMAGE_TAG="$sha" compose run --rm -T migrate; then
  echo "Миграции не прошли — приложение не тронуто, работает ${previous:-прежняя версия}." >&2
  echo "Миграция могла примениться частично. Состояние — в $DIR от root:" >&2
  echo "  IMAGE_TAG=$sha docker compose --env-file .env run --rm -T migrate npx prisma migrate status" >&2
  echo "Что дальше — deploy/README.md, «Сбой миграции»." >&2
  exit 1
fi

# 3–4. Пересоздаётся только приложение: без --no-deps compose остановил бы его
# раньше, чем снова прогнал бы миграции, — это и был простой при выкладке.
set_tag "$sha"
if ! compose up -d --no-deps app || ! healthy; then
  echo "Приложение $sha не поднялось или не ответило 200 за $((HEALTH_TRIES * 2)) с (последний код: ${code:-нет})" >&2
  show_state
  if [[ -z "$previous" || "$previous" == "$sha" ]]; then
    echo "Откатываться не на что: прежнего тега нет или это тот же SHA." >&2
    exit 1
  fi
  echo "Откат на $previous. Схема базы остаётся новой: миграции только вперёд и совместимы с прежней версией." >&2
  set_tag "$previous"
  if compose up -d --no-deps app && healthy; then
    echo "Откат прошёл, работает $previous. Выкладка $sha не удалась." >&2
  else
    echo "Откат на $previous тоже не ответил 200 (последний код: ${code:-нет})." >&2
    show_state
  fi
  exit 1
fi

# 5. Чистятся только образы этого проекта: текущий и предыдущий остаются для
# отката. Общий docker image prune задел бы соседей. Повтор того же SHA не
# чистит ничего: иначе вместе с «предыдущим», то есть им же, ушёл бы образ
# настоящей прежней версии.
if [[ "$previous" != "$sha" ]]; then
  keep=" $sha migrate-$sha "
  if [[ -n "$previous" ]]; then
    keep+="$previous migrate-$previous "
  fi
  docker images "$IMAGE" --format '{{.Tag}}' | while read -r tag; do
    if [[ "$keep" != *" $tag "* ]]; then
      docker image rm "$IMAGE:$tag" >/dev/null 2>&1 || true
    fi
  done
fi

echo "Выложен $sha"
