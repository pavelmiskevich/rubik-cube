generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(uuid(7))
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid(7))
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String            @id @default(uuid(7))
  name          String?
  email         String            @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime          @default(now())
  accounts      Account[]
  sessions      Session[]
  trainingSessions TrainingSession[]
  lessonProgress   LessonProgress[]
}

model TrainingSession {
  id        String   @id @default(uuid(7))
  userId    String
  name      String   @default("Main 3x3")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  solves    Solve[]

  @@index([userId])
}

model Solve {
  id                String          @id @default(uuid(7))
  trainingSessionId String
  timeMs            Int      
  scramble          String
  isDNF             Boolean         @default(false)
  isPlusTwo         Boolean         @default(false)
  createdAt         DateTime        @default(now())
  trainingSession   TrainingSession @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)

  @@index([trainingSessionId, createdAt])
}

/// Где человек остановился в уроке. Одна строка на пару «пользователь + урок»:
/// повторное прохождение обновляет её, а не плодит новые.
model LessonProgress {
  id         String   @id @default(uuid(7))
  userId     String
  /// Идентификатор урока — slug из src/content/lessons. Уроки живут в коде,
  /// поэтому внешнего ключа нет: удалённый из курса урок оставит строку-сироту,
  /// которую просто никто не прочитает.
  lessonSlug String
  /// Номер открытого шага, с нуля.
  stepIndex  Int      @default(0)
  /// Урок пройден до конца. Однажды поставленная отметка не снимается.
  completed  Boolean  @default(false)
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonSlug])
}
