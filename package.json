{
  "name": "rubik-cube",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "jest",
    "prepare": "husky",
    "postinstall": "prisma generate",
    "test:e2e": "start-server-and-test dev http://localhost:3000 \"cypress run\"",
    "test:e2e:db": "start-server-and-test dev http://localhost:3000 \"cypress run --config specPattern=cypress/e2e/db/*.cy.ts\"",
    "test:e2e:ci": "start-server-and-test \"node .next/standalone/server.js\" http://localhost:3000 \"cypress run --config specPattern=cypress/e2e/**/*.cy.ts\""
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "bcryptjs": "^3.0.3",
    "next": "^16.3.2",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "audit-ci": "^7.1.0",
    "cypress": "^15.21.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "postcss": "^8",
    "prisma": "^7.9.1",
    "start-server-and-test": "^3.0.12",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.4.12",
    "typescript": "^5"
  },
  "overrides": {
    "mysql2": "^3.24.4",
    "deepmerge-ts": "^8.0.2"
  }
}
